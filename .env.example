# Copy to .env. Nothing in the test code contains a URL; everything comes from here.
ENV=local
# Web app under test. With START_SERVER=true the framework starts app/server.js on this port.
BASE_URL=http://localhost:4173
START_SERVER=true
# API under test (A3)
API_BASE_URL=https://jsonplaceholder.typicode.com
HEADLESS=true
# Per-test limits
API_MAX_RESPONSE_MS=5000
# Optional: enables the AI mode of the self-healing POC (npm run heal). Never commit a real key.
ANTHROPIC_API_KEY=
